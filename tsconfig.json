{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "@dlusn/ai": ["./src/index.ts"],
      "@dlusn/ai/speech": ["./src/speech/index.ts"],
      "@dlusn/ai/stub": ["./src/stub.ts"],
      "@dlusn/ai/pricing": ["./src/pricing.ts"]
    }
  },
  "include": ["src", "test", "fixtures"]
}
